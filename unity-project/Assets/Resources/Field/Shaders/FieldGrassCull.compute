// v7.0.2: selección de hierba en GPU. Cada trozo ocupa una ranura fija del búfer de instancias; por fotograma se
// recorren solo las ranuras activas, se descartan las matas fuera de la vista o de su banda de LOD y las visibles se
// copian (ya desplazadas y con el fundido aplicado a la escala) a la región de su especie. Resultado: 1 llamada por especie.
#pragma kernel Cull
#pragma kernel Clear
#pragma kernel Clamp

struct Inst { float4 pos; float4 prm; };     // prm.y = especie + tono (parte fraccionaria)
StructuredBuffer<Inst> _Src;
RWStructuredBuffer<Inst> _Dst;
RWStructuredBuffer<uint> _Args;              // 5 uint por especie; [1] = instancias
StructuredBuffer<float4> _Slots;             // por ranura activa: x = primer índice, y = cantidad, z/w = desplazamiento XZ
StructuredBuffer<float4> _Bands;             // por ranura activa: x = inicio, y = fin, z = fundido
float4 _Planes[6];
float4 _Cam;                                 // xyz cámara, w = nº de ranuras activas
uint _KindCap, _Kinds;

[numthreads(64, 1, 1)]
void Clear(uint3 id : SV_DispatchThreadID)
{
    if (id.x < _Kinds) _Args[id.x * 5 + 1] = 0;
}

[numthreads(64, 1, 1)]
void Cull(uint3 gid : SV_GroupID, uint3 tid : SV_GroupThreadID)
{
    float4 sl = _Slots[gid.x];
    float4 bd = _Bands[gid.x];
    uint first = (uint)sl.x, count = (uint)sl.y;
    for (uint i = tid.x; i < count; i += 64)
    {
        Inst I = _Src[first + i];
        float3 p = I.pos.xyz + float3(sl.z, 0, sl.w);
        float dc = distance(p.xz, _Cam.xz);
        float fade = smoothstep(bd.x - bd.z, bd.x + bd.z, dc) * (1.0 - smoothstep(bd.y - bd.z, bd.y + bd.z, dc));
        if (fade <= 0.001) continue;
        float r = I.pos.w * 1.6 + 0.5;
        float3 c = p + float3(0, r * 0.5, 0);
        bool vis = true;
        [unroll] for (int k = 0; k < 6; k++) if (dot(_Planes[k].xyz, c) + _Planes[k].w < -r) vis = false;
        if (!vis) continue;
        uint kind = min((uint)I.prm.y, _Kinds - 1);
        uint slot;
        InterlockedAdd(_Args[kind * 5 + 1], 1, slot);
        if (slot >= _KindCap) continue;
        Inst o = I; o.pos.xyz = p; o.pos.w = I.pos.w * fade; o.prm.y = frac(I.prm.y);
        _Dst[kind * _KindCap + slot] = o;
    }
}

[numthreads(64, 1, 1)]
void Clamp(uint3 id : SV_DispatchThreadID)
{
    if (id.x < _Kinds) _Args[id.x * 5 + 1] = min(_Args[id.x * 5 + 1], _KindCap);
}
